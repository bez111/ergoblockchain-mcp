PORT=8787
HOST=0.0.0.0
MCP_PUBLIC_BASE_URL=https://mcp.ergoblockchain.org
SITE_BASE_URL=https://www.ergoblockchain.org
SAGE_API_BASE=https://www.ergoblockchain.org

# Optional, but recommended before exposing the endpoint publicly.
# When set, every /mcp request must include:
# Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=

# Comma-separated hostnames accepted in the Host header.
# Keep localhost values for local testing.
ALLOWED_HOSTS=localhost,127.0.0.1,::1,mcp.ergoblockchain.org

# Comma-separated origins for browsers/proxies that send Origin.
# Use * only for local testing.
ALLOWED_ORIGINS=https://www.ergoblockchain.org,https://ergoblockchain.org
