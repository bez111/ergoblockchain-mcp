{
  "name": "@ergoblockchain/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Streamable HTTP MCP endpoint for Ergo/Sage tools.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "sync:sage-index": "node scripts/sync-sage-index.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
